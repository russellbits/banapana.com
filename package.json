{
	"name": "banapana",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host --port 2222",
		"dev:full": "node scripts/watch-content.js",
		"build": "vite build && node scripts/generate-sitemap.js && node scripts/generate-rss.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"sync": "node scripts/sync-content.js",
		"deploy": "node scripts/deploy.js",
		"sync:deploy": "npm run sync && npm run build && npm run deploy",
		"cron": "npm run sync && npm run build && npm run deploy"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.0.0",
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@storybook/addon-a11y": "^10.2.7",
		"@storybook/addon-docs": "^10.2.7",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^10.2.7",
		"@storybook/sveltekit": "^10.2.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.18",
		"@vitest/coverage-v8": "^4.0.18",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.2.7",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"mdsvex": "^0.12.6",
		"mdsvex-relative-images": "^2.0.0",
		"playwright": "^1.58.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"storybook": "^10.2.7",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-imagetools": "^9.0.2",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.18",
		"vitest-browser-svelte": "^2.0.2"
	},
	"dependencies": {
		"basic-ftp": "^5.1.0",
		"dotenv": "^17.3.1",
		"front-matter": "^4.0.2",
		"glob": "^13.0.3",
		"simple-machines": "^0.8.0"
	}
}
